// Calcula el volumen y area de una esfera.
Algoritmo volumen_area_esfera
	Definir a, v, r Como Real
	Escribir "Ingresa el valor del radio de la esfera: "
	Leer r
	a <- 4 * 3.1416 * r * r
	v <- (4 / 3) * 3.1416 * r * r * r
	Escribir "El area de la esfera es " a
	Escribir "El volumen de la esfera es de " v
FinAlgoritmo
