Algoritmo area_trapecio
	Definir baseMayor, baseMenor, h, a Como Real
	Escribir "Ingresa el valor de la Base Mayor: "
	Leer baseMayor
	Escribir "Ingresa el valor de la base Menor: "
	Leer baseMenor
	Escribir "Ingresa el valor de la Altrua: "
	Leer h
	a <- ((baseMayor + baseMenor)/2) * h
	Escribir "El area del trapecio es: " a
FinAlgoritmo
